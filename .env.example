# Copier vers .env — ne jamais committer .env ni de secrets.
# Sans clés Wasabi, le même pipeline tourne sur le disque local (npm start).

PORT=4180
HOST=0.0.0.0
NODE_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:4180
DATA_DIR=./data

# Démo locale, au premier démarrage seulement (data/store.json).
# koko@demo.storeforall et maman@demo.storeforall
DEMO_PASSWORD=storeforall-demo
PLATFORM_EMAIL=platform@demo.storeforall
PLATFORM_PASSWORD=storeforall-demo

# Signature des URL de morceaux (obligatoire si NODE_ENV=production).
SESSION_SECRET=

# Wasabi — fichiers uniquement. Le site public est Vercel.
# Hetzner garde les marchands, commandes, produits, et le pipeline média.
# Laisser vide en local.
WASABI_ACCESS_KEY=
WASABI_SECRET_KEY=
WASABI_BUCKET_NAME=storeforall-medias
WASABI_REGION=eu-central-1
WASABI_ENDPOINT_URL=https://s3.eu-central-1.wasabisys.com
# WASABI_PUBLIC_BASE_URL=https://media.example.com

# Bunny CDN devant le bucket (hostname sans https://).
# BUNNY_CDN_HOSTNAME=storeforall.b-cdn.net
BUNNY_CDN_HOSTNAME=
# Purge uniquement, jamais dans le navigateur.
BUNNY_API_KEY=

# Taille d'un morceau en local (octets). Wasabi ignore une valeur < 5 Mo et reste à 8 Mo.
# MEDIA_PART_BYTES=524288
